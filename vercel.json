{
  "redirects": [
    {
      "source": "/jardim",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/jardim/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projetos/:slug*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/seq/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/flor",
      "destination": "/flor.html"
    }
  ]
}
